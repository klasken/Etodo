# Copier ce fichier en .env puis remplacer les valeurs : cp .env.example .env
# Le fichier .env est ignoré par Git, ne jamais y committer de vrais secrets.

# --- Base de données (utilisée par l'API et par le conteneur MySQL) ---
MYSQL_HOST=mysql
MYSQL_DATABASE=etodo
MYSQL_USER=etodo
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_too

# --- API ---
# Garder 3000 : le front-end appelle http://localhost:3000
PORT=3000
# Clé de signature des JWT (générer une longue chaîne aléatoire, ex. : openssl rand -hex 32)
SECRET=change_me_with_a_long_random_string
